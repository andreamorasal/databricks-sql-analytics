   "source": [
    "-- 2. Revenue by payment method.\n",
    "\n",
    "SELECT \n",
    "    cash_type AS payment_method,\n",
    "    ROUND(SUM(money),2) as revenue\n",
    "FROM `workspace`.`default`.`coffee`\n",
    "GROUP BY cash_type\n",
    "ORDER BY revenue DESC;"
   ]
